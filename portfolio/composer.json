{
    "name": "gllhub/portfolio",
    "description": "Content types for a personal portfolio on gllHub: project, idea, article, page.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "gllhub/contracts": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gll\\Hub\\Portfolio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gll\\Hub\\Portfolio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "gllhub": {
            "package": "Gll\\Hub\\Portfolio\\PortfolioPackage"
        }
    }
}
