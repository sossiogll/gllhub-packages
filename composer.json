{
    "name": "gllhub/packages-workspace",
    "description": "Development workspace of the gllHub packages: installs them together, with the contract from the core checked out next to this repository. Each folder is published on its own.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        { "type": "path", "url": "../gll-hub/contracts", "options": { "symlink": true, "versions": { "gllhub/contracts": "1.0.x-dev" } } },
        { "type": "path", "url": "portfolio", "options": { "symlink": true, "versions": { "gllhub/portfolio": "0.1.x-dev" } } },
        { "type": "path", "url": "medium", "options": { "symlink": true, "versions": { "gllhub/medium": "0.1.x-dev" } } },
        { "type": "path", "url": "github", "options": { "symlink": true, "versions": { "gllhub/github": "0.1.x-dev" } } },
        { "type": "path", "url": "json-resume", "options": { "symlink": true, "versions": { "gllhub/json-resume": "0.1.x-dev" } } }
    ],
    "require": {
        "php": "^8.4",
        "gllhub/contracts": "@dev",
        "gllhub/portfolio": "@dev",
        "gllhub/medium": "@dev",
        "gllhub/github": "@dev",
        "gllhub/json-resume": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
