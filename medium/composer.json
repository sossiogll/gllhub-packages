{
    "name": "gllhub/medium",
    "description": "Brings a Medium author's articles into gllHub, from their RSS feed.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "gllhub/contracts": "^1.0",
        "gllhub/portfolio": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gll\\Hub\\Medium\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gll\\Hub\\Medium\\Tests\\": "tests/"
        }
    },
    "extra": {
        "gllhub": {
            "package": "Gll\\Hub\\Medium\\MediumPackage"
        }
    }
}
