{
    "name": "gllhub/json-resume",
    "description": "Brings a CV into gllHub from a JSON Resume file.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "gllhub/contracts": "^1.0",
        "gllhub/portfolio": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gll\\Hub\\JsonResume\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gll\\Hub\\JsonResume\\Tests\\": "tests/"
        }
    },
    "extra": {
        "gllhub": {
            "package": "Gll\\Hub\\JsonResume\\JsonResumePackage"
        }
    }
}
