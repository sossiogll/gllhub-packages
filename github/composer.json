{
    "name": "gllhub/github",
    "description": "Brings an account's showcase repositories into gllHub as projects.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "gllhub/contracts": "^1.0",
        "gllhub/portfolio": "^0.1",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gll\\Hub\\Github\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gll\\Hub\\Github\\Tests\\": "tests/"
        }
    },
    "extra": {
        "gllhub": {
            "package": "Gll\\Hub\\Github\\GithubPackage"
        }
    }
}
